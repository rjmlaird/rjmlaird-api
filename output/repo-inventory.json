    "name": "rjmlaird-portfolio-api",
    "scripts": {
      "dev": "wrangler dev",
      "deploy": "wrangler deploy",
      "check": "tsc --noEmit",
      "test": "vitest run",
      "data": "node scripts/sanitise-data.mjs"
    }
  },
  "workers": [
    {
      "file": "wrangler.jsonc",
      "name": "rjmlaird-api",
      "main": "src/index.ts",
      "compatibility_date": "2026-10-10",
      "compatibility_flags": [],
      "production": {
        "routes": [
          "api.rjmlaird.co.uk"
        ],
        "producers": [],
        "consumers": [],
        "d1": [],
        "services": [],
        "kv": [],
        "r2": [],
        "durable_objects": [],
        "vectorize": [],
        "ai": null,
        "vars": [
          "API_ORIGIN",
          "API_VISIBILITY",
          "ENVIRONMENT",
          "SITE_ORIGIN"
        ],
        "crons": []
      },
      "environments": {}
    }
